# OCI CLI configuration from `oci setup config`
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT

# Instance placement and resources
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..example
OCI_AVAILABILITY_DOMAIN=example:REGION-AD-1
OCI_SUBNET_ID=ocid1.subnet.oc1..example
OCI_IMAGE_ID=ocid1.image.oc1..example
OCI_SHAPE=VM.Standard.A1.Flex
OCI_DISPLAY_NAME=capacity-retry-instance
OCI_OCPUS=1
OCI_MEMORY_GB=6
OCI_BOOT_VOLUME_GB=50
OCI_ASSIGN_PUBLIC_IP=true

# SSH public key (not the private key)
OCI_SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub

# Start at 60 seconds, increase up to 15 minutes, retry forever
OCI_RETRY_SECONDS=60
OCI_MAX_RETRY_SECONDS=900
OCI_MAX_ATTEMPTS=0
